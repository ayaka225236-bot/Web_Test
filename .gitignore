# 依赖
/node_modules
/.pnp
.pnp.*

# 本地 npm 缓存（当系统缓存目录不可写时使用，见 README）
/.npm-cache/

# Next.js 构建产物
/.next/
/out/
/build

# 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 环境变量（本地配置，不入库）
.env
.env*.local

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# TypeScript 增量缓存
*.tsbuildinfo
next-env.d.ts
